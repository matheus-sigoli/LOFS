# Copie para .env.local e preencha. NUNCA versione o .env.local.
# Valores do Supabase local: `npx supabase status`

# Públicas (vão para o navegador — só a URL e a chave anon, protegidas pelo RLS)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública do site (usada no link mágico de login)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Somente servidor — NUNCA prefixar com NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
FIRECRAWL_API_KEY=
